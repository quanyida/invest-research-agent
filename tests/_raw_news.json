      {
        "type": "text",
        "text": "{\"code\":1,\"msg\":\"success\",\"subCode\":null,\"subMsg\":null,\"data\":{\"data\":\"[\\n  {\\n    \\\"\u8d44\u8baf\u6807\u9898\\\": \\\"\u5728\u6d77\u5916\u5efa\u4e86\u5b8c\u6574\u4f9b\u5e94\u94fe\u4f53\u7cfb\u7684\u4e2d\u56fd\u4f01\u4e1a\uff1aTCL\u3001\u5b81\u5fb7\u65f6\u4ee3\u4e0e\u798f\u8000\\\",\\n    \\\"\u8d44\u8baf\u5185\u5bb9\\\": \\\"\u4e8c\u3001\u5b81\u5fb7\u65f6\u4ee3\uff1a\u628a\u52a8\u529b\u7535\u6c60\u4ea7\u80fd\u5efa\u5230\u6b27\u6d32 \u5b81\u5fb7\u65f6\u4ee3\u7684\u6d77\u5916\u4f9b\u5e94\u94fe\uff0c\u5efa\u5728\u6b27\u6d32\u6574\u8f66\u5382\u8eab\u8fb9\u3002\u636e\u6bcf\u65e5\u7ecf\u6d4e\u65b0\u95fb\u62a5\u9053\uff0c2025\u5e74\uff0c\u5b81\u5fb7\u65f6\u4ee3\u5168\u5e74\u5b9e\u73b0\u8425\u4e1a\u6536\u51654237.02\u4ebf\u5143\uff0c\u9502\u7535\u6c60\u9500\u91cf661GWh\uff0c\u540c\u6bd4\u589e\u957f39%\uff0c\u5168\u7403\u5e02\u5360\u7387\u9ad8\u8fbe39.2%\u30022026\u5e749\u6708\uff0c\u4e2d\u56fd\u4f01\u4e1a\u5728\u6d77\u5916\u6295\u8d44\u89c4\u6a21\u6700\u5927\u7684\u52a8\u529b\u7535\u6c60\u751f\u4ea7\u57fa\u5730\u2014\u2014\u5b81\u5fb7\u65f6\u4ee3\u4f4d\u4e8e\u5308\u7259\u5229\u5fb7\u5e03\u52d2\u68ee\u7684\u65b0\u5efa\u7535\u82af\u5de5\u5382\u6b63\u5f0f\u542f\u52a8\u751f\u4ea7\u3002\u636e\u79d1\u6280\u65e5\u62a5\u62a5\u9053\uff0c\u8be5\u57fa\u5730\u603b\u6295\u8d44\u7ea673.4\u4ebf\u6b27\u5143\uff0c\u89c4\u5212\u4ea7\u80fd100GWh\u3002\u8be5\u5382\u9996\u5ea7\u7535\u82af\u5382\u623f\u4e8e2023\u5e74\u590f\u5b63\u5f00\u5de5\u5efa\u8bbe\uff0c\u5e76\u4e8e2026\u5e74\u6625\u5b63\u5b8c\u6210\u5148\u8fdb\u751f\u4ea7\u6280\u672f\u53ca\u8bbe\u5907\u914d\u7f6e\u3002\u6309\u89c4\u5212\uff0c\u8be5\u5de5\u5382\u4e00\u671f34GWh\u4ea7\u80fd\u8ba1\u5212\u5c31\u8fd1\u4f9b\u5e94\u5954\u9a70\u3001\u5b9d\u9a6c\u3001\u5927\u4f17\u7b49\u6b27\u6d32\u5ba2\u6237\u3002\u897f\u73ed\u7259\u662f\u5b81\u5fb7\u65f6\u4ee3\u5728\u6b27\u6d32\u7684\u53e6\u4e00\u5904\u5e03\u5c40\u30022025\u5e7411\u6708\uff0c\u5b81\u5fb7\u65f6\u4ee3\u548c\u65af\u6cf0\u5170\u8482\u65af\u96c6\u56e2\u5728\u897f\u73ed\u7259\u963f\u62c9\u8d21\u81ea\u6cbb\u533a\u5171\u540c\u6295\u8d44\u5efa\u8bbe\u7684\u78f7\u9178\u94c1\u9502\u7535\u6c60\u5de5\u5382\u4e3e\u884c\u5960\u57fa\u4eea\u5f0f\uff0c\u9879\u76ee\u603b\u6295\u8d4441\u4ebf\u6b27\u5143\uff0c\u89c4\u5212\u5e74\u4ea7\u80fd\u53ef\u8fbe50\u5409\u74e6\u65f6\uff0c\u8ba1\u52122026\u5e74\u5e74\u5e95\u6295\u4ea7\u3002\u4e09\u3001\u798f\u8000\uff1a\u5728\u5168\u740313\u4e2a\u56fd\u5bb6\u5efa\u7acb\u4ea7\u9500\u7814\u57fa\u5730 \u798f\u8000\u7684\u6d77\u5916\u4f9b\u5e94\u94fe\uff0c\u56f4\u7ed5\u6c7d\u8f66\u73bb\u7483\u8fd9\u4e00\u4e2a\u54c1\u7c7b\u5c55\u5f00\u3002\u636e\u4e2d\u65b0\u7f51\u62a5\u9053\uff0c\u7531\u66f9\u5fb7\u65fa\u521b\u7acb\u7684\u798f\u8000\u96c6\u56e2\uff0c\u662f\u5168\u7403\u6700\u5927\u7684\u6c7d\u8f66\u73bb\u7483\u548c\u6c7d\u8f66\u9970\u4ef6\u4e00\u4f53\u5316\u89e3\u51b3\u65b9\u6848\u4f9b\u5e94\u5546\uff0c\u5168\u7403\u5e02\u5360\u7387\u8fbe35%\u3002\u7eaa\u5f55\u7247\u300a\u7f8e\u56fd\u5de5\u5382\u300b\u8bb0\u5f55\u7684\uff0c\u6b63\u662f\u798f\u8000\u5728\u7f8e\u56fd\u6295\u8d44\u5efa\u5382\u7684\u5386\u7a0b\\\\n......\u4ee5\u4e0a\u4ec5\u4e3a\u6b63\u6587\u5185\u5bb9\u8282\u9009\\\\n\\\",\\n    \\\"\u65e5\u671f\\\": \\\"2026-11-10\\\",\\n    \\\"URL\\\": \\\"http://finance.sina.com.cn/roll/2026-11-10/doc-iniyfzhu5906452.shtml\\\"\\n  },\\n  {\\n    \\\"\u8d44\u8baf\u6807\u9898\\\": \\\"\u589e\u957f\u903b\u8f91\u6539\u53d8 \u5b81\u5fb7\u65f6\u4ee3\u8fce\u6765\u4ef7\u503c\u91cd\u4f30\u65b0\u547d\u9898\\\",\\n    \\\"\u8d44\u8baf\u5185\u5bb9\\\": \\\"\u805a\u7126\u5230\u4eca\u5e74\u7b2c\u4e09\u5b63\u5ea6\uff0c\u5b81\u5fb7\u65f6\u4ee3\u52a8\u529b\u548c\u50a8\u80fd\u5408\u8ba1\u9500\u91cf\u8d85\u8fc7260GWh\uff0c\u5176\u4e2d\u50a8\u80fd\u9500\u91cf\u540c\u6bd4\u589e\u901f\u63a5\u8fd160%\uff0c\u6839\u636e\u6b64\u524d\u6d88\u606f\uff0c\u5b81\u5fb7\u65f6\u4ee3\u5929\u6052\u94a0\u7535\u50a8\u80fd\u7cfb\u7edf\u7b7e\u7ea6\u591a\u4e2a\u6b27\u6d32\u5ba2\u6237\u3002\u8fd9\u4e24\u6761\u589e\u957f\u66f2\u7ebf\uff0c\u5468\u671f\u5e76\u4e0d\u540c\u6b65\u3002\u52a8\u529b\u7535\u6c60\u8ddf\u968f\u6c7d\u8f66\u6d88\u8d39\u5468\u671f\u6ce2\u52a8\uff0c\u53d7\u8f66\u578b\u8fed\u4ee3\u3001\u7ec8\u7aef\u8d2d\u8f66\u9700\u6c42\u7275\u5f15\uff1b\u50a8\u80fd\u4e1a\u52a1\u951a\u5b9a\u80fd\u6e90\u57fa\u5efa\u6295\u8d44\uff0c\u589e\u957f\u8282\u594f\u7531\u7535\u7f51\u6539\u9020\u3001\u65b0\u80fd\u6e90\u914d\u5957\u7684\u8d44\u672c\u5f00\u652f\u51b3\u5b9a\u3002\u4e8c\u8005\u5929\u7136\u5f62\u6210\u5468\u671f\u9519\u4f4d\uff0c\u80fd\u591f\u5bf9\u51b2\u5355\u4e00\u884c\u4e1a\u6ce2\u52a8\u3002\u5728\u56fd\u5185\u4e24\u6761\u4e1a\u52a1\u66f2\u7ebf\u4e92\u76f8\u6258\u5e95\u7684\u540c\u65f6\uff0c\u5b81\u5fb7\u65f6\u4ee3\u7684\u5168\u7403\u5316\u5e03\u5c40\u4e5f\u4ece\u4ea7\u54c1\u8f93\u51fa\u8fc8\u5165\u4ea7\u80fd\u843d\u5730\u7684\u65b0\u9636\u6bb5\u30029\u670822\u65e5\uff0c\u5308\u7259\u5229\u5fb7\u5e03\u52d2\u68ee\u5de5\u5382\u9996\u5ea7\u7535\u82af\u5382\u623f\u542f\u52a8\u8bd5\u751f\u4ea7\uff0c\u89c4\u5212\u4ea7\u80fd100GWh\uff0c\u662f\u5b81\u5fb7\u65f6\u4ee3\u5728\u4e2d\u56fd\u4ee5\u5916\u6700\u5927\u7684\u751f\u4ea7\u57fa\u5730\u3002\u5fb7\u56fd\u56fe\u6797\u6839\u5de5\u5382\u5df2\u7ecf\u8dd1\u901a\u4e86\u76c8\u5229\u6a21\u578b\uff0c\u897f\u73ed\u7259\u8428\u62c9\u6208\u8428\u7684\u5408\u8d44\u5de5\u5382\u5728\u63a8\u8fdb\u4e2d\uff0c\u5370\u5c3c\u7684\u954d\u77ff\u5230\u7535\u6c60\u95ed\u73af\u9879\u76ee\u4e5f\u5df2\u52a8\u5de5\u3002\u4f9d\u6258\u5168\u7403\u5ba2\u6237\u8ba2\u5355\u4e0e\u672c\u5730\u5316\u4ea7\u80fd\u6301\u7eed\u843d\u5730\uff0c\u4eca\u5e74\u4e0a\u534a\u5e74\uff0c\u5b81\u5fb7\u65f6\u4ee3\u6d77\u5916\u6536\u5165871.29\u4ebf\u5143\uff0c\u5360\u6bd431.46%\uff0c\u6bdb\u5229\u738729.97%\u3002\u773c\u4e0b\uff0c\u5b81\u5fb7\u65f6\u4ee3\u5df2\u7ecf\u4ece\u5355\u4e00\u52a8\u529b\u7535\u6c60\u5382\u5546\uff0c\u9010\u6b65\u6f14\u5316\u6210\u201c\u52a8\u529b+\u50a8\u80fd+\u6d77\u5916\u4ea7\u80fd+\u6280\u672f\u6388\u6743\u201d\u7684\u591a\u5143\u4e1a\u52a1\u67b6\u6784\u3002\u62a4\u57ce\u6cb3\u4e4b\u53d8 \u6bd4\u4e1a\u52a1\u7ed3\u6784\u66f4\u9690\u853d\u7684\u53d8\u5316\uff0c\u662f\u62a4\u57ce\u6cb3\u7684\u5f62\u6001\u5728\u8fc1\u79fb\u3002\u8fc7\u53bb\uff0c\u56fd\u5185\u6c7d\u8f66\u4e3b\u673a\u5382\u548c\u52a8\u529b\u7535\u6c60\u4f01\u4e1a\u7684\u58c1\u5792\u591a\u662f\u4ea7\u80fd\u548c\u89c4\u6a21\uff1a\u7528\u6700\u5927\u7684\u5236\u9020\u4f53\u91cf\u644a\u8584\u6210\u672c\uff0c\u7528\u6210\u672c\u4f18\u52bf\u9501\u4f4f\u5ba2\u6237\\\\n......\u4ee5\u4e0a\u4ec5\u4e3a\u6b63\u6587\u5185\u5bb9\u8282\u9009\\\\n\\\",\\n    \\\"\u65e5\u671f\\\": \\\"2026-10-23\\\",\\n    \\\"URL\\\": \\\"http://finance.sina.com.cn/jjxw/2026-10-23/doc-iniweiyu8020644.shtml\\\"\\n  },\\n  {\\n    \\\"\u8d44\u8baf\u6807\u9898\\\": \\\"\u5b81\u5fb7\u65f6\u4ee3\uff0c\u5927\u52a8\u4f5c\uff01\u9502\u7535\u4ea7\u4e1a\u94fe\u8d74\u6b27\u5efa\u5382\u70ed\u6f6e\u518d\u8d77\\\",\\n    \\\"\u8d44\u8baf\u5185\u5bb9\\\": \\\"\u8d74\u6b27\u5efa\u5382\u70ed\u6f6e\u518d\u8d77\uff0c\u80cc\u540e\u5b58\u5728\u53cc\u91cd\u9a71\u52a8\u3002\\\\n\u8fd1\u671f\uff0c\u9502\u7535\u4ea7\u4e1a\u94fe\u9f99\u5934\u4f01\u4e1a\u6b27\u6d32\u9879\u76ee\u63a8\u8fdb\u8282\u594f\u660e\u663e\u63d0\u901f\uff1a\u5b81\u5fb7\u65f6\u4ee3\u5308\u7259\u5229\u7535\u82af\u5de5\u5382\u542f\u52a8\u751f\u4ea7\u3001\u56fd\u8f69\u9ad8\u79d1\u5ba3\u5e03\u4e0e\u5927\u4f17\u65d7\u4e0b\u516c\u53f8\u5408\u8d44\u5728\u897f\u73ed\u7259\u53ca\u65af\u6d1b\u4f10\u514b\u6295\u5efa\u7535\u6c60\u5382\u3001\u6e56\u5357\u88d5\u80fd\u5927\u5e45\u4e0a\u8c03\u897f\u73ed\u7259\u9879\u76ee\u6295\u8d44\u989d\u3002\\\\n\u8d74\u6b27\u5efa\u5382\u70ed\u6f6e\u518d\u8d77\uff0c\u80cc\u540e\u5b58\u5728\u53cc\u91cd\u9a71\u52a8\u3002\u6b27\u76df\u300a\u7535\u6c60\u548c\u5e9f\u7535\u6c60\u6cd5\u89c4\u300b\u300a\u51c0\u96f6\u5de5\u4e1a\u6cd5\u6848\u300b\u7b49\u843d\u5730\u5b9e\u65bd\uff0c\u78b3\u8db3\u8ff9\u3001\u7535\u6c60\u62a4\u7167\u7b49\u4ea7\u4e1a\u89c4\u5219\u5012\u903c\u9502\u7535\u4ea7\u4e1a\u94fe\u52a0\u5feb\u5728\u6b27\u672c\u571f\u5316\u5e03\u5c40\uff1b\u6b27\u6d32\u52a8\u529b\u7535\u6c60\u3001\u50a8\u80fd\u5e02\u573a\u9ad8\u901f\u6269\u5bb9\uff0c\u8fdb\u4e00\u6b65\u4e3a\u65b0\u589e\u4ea7\u80fd\u6253\u5f00\u9700\u6c42\u7a97\u53e3\u3002\\\\n\u591a\u6570\u53d7\u8bbf\u4eba\u58eb\u8ba4\u4e3a\uff0c\u76ee\u524d\u56fd\u5185\u9502\u7535\u4ea7\u4e1a\u94fe\u4f01\u4e1a\u6d77\u5916\u5e03\u5c40\u5df2\u7ecf\u4ece\u65e9\u5e74\u7684\u201c\u5361\u4f4d\u8d5b\u201d\uff0c\\\\n......\u5f53\u4e2d\u7701\u75652131\u5b57\u6b63\u6587\u5185\u5bb9......\\\\n\u5b9e\u73b0\u7a33\u5b9a\u91cf\u4ea7\u53ca\u76c8\u5229\uff0c\u8017\u65f6\u4f1a\u66f4\u957f\u3002\u201d\u6731\u4e1c\u7526\u8868\u793a\uff0c\u76ee\u524d\u6b27\u6d32\u672c\u5730\u4f9b\u5e94\u94fe\u5c1a\u5904\u5728\u57f9\u80b2\u9636\u6bb5\uff0c\u4e0a\u6e38\u96f6\u90e8\u4ef6\u914d\u5957\u3001\u719f\u7ec3\u4ea7\u4e1a\u5de5\u4eba\u7684\u4f9b\u7ed9\u5b58\u5728\u74f6\u9888\uff0c\u4ea7\u80fd\u722c\u5761\u662f\u884c\u4e1a\u666e\u904d\u9762\u4e34\u7684\u95ee\u9898\u3002\\\\n\u5728\u738b\u677e\u6d9b\u770b\u6765\uff0c\u9502\u7535\u4f01\u4e1a\u51fa\u6d77\u771f\u6b63\u7684\u6311\u6218\u4e0d\u662f\u628a\u4e00\u5ea7\u5de5\u5382\u5efa\u5230\u6d77\u5916\uff0c\u800c\u662f\u8ba9\u7535\u6c60\u6280\u672f\u5728\u4e0d\u540c\u56fd\u5bb6\u6301\u7eed\u5b9e\u73b0\u9ad8\u8d28\u91cf\u3001\u89c4\u6a21\u5316\u3001\u5177\u6709\u6210\u672c\u7ade\u4e89\u529b\u7684\u4ea4\u4ed8\u3002\\\\n\u201c\u5f53\u524d\u9502\u7535\u4ea7\u4e1a\u94fe\u8d74\u6b27\u5efa\u5382\u8fdb\u5165\u7cbe\u7ec6\u5316\u8fd0\u8425\u9636\u6bb5\uff0c\u98ce\u9669\u7ba1\u63a7\u662f\u6838\u5fc3\u547d\u9898\u3002\u5177\u5907\u7a33\u5b9a\u5728\u624b\u8ba2\u5355\u3001\u5065\u5168\u5408\u89c4\u4f53\u7cfb\u3001\u5468\u5bc6\u4f9b\u5e94\u94fe\u9884\u6848\u7684\u4f01\u4e1a\uff0c\u65b9\u80fd\u884c\u7a33\u81f4\u8fdc\uff0c\u5728\u6fc0\u70c8\u7684\u5e02\u573a\u7ade\u4e89\u4e2d\u7a81\u56f4\u3002\u201d\u6731\u4e1c\u7526\u8868\u793a\u3002\\\\n\u672c\u6587\u539f\u8f7d\u4e8e\u300a\u8bc1\u5238\u65f6\u62a5\u300b10\u670820\u65e5A4\u7248\\\",\\n    \\\"\u65e5\u671f\\\": \\\"2026-10-20\\\",\\n    \\\"URL\\\": \\\"https://stcn.com/article/detail/4227384.html\\\"\\n  },\\n  {\\n    \\\"\u5907\u6ce8\\\": \\\"\u51fa\u4e8e\u5bf9LLM\u4e0a\u4e0b\u6587\u4ee5\u53ca\u7528\u6237token\u8d44\u6e90\u7684\u4fdd\u62a4\uff0c\u672c\u5de5\u5177\u4ec5\u8f93\u51fa\u4e0e\u67e5\u8be2\u5185\u5bb9\u5f3a\u76f8\u5173\u7684\u8d44\u8baf\u7247\u6bb5\uff0c\u800c\u975e\u8d44\u8baf\u5168\u6587\uff0c\u5982\u60a8\u9700\u8981\u5bf9\u5168\u6587\u8fdb\u884c\u6eaf\u6e90\u6216\u83b7\u53d6\u66f4\u591a\u4fe1\u606f\uff0c\u5efa\u8bae\u4f7f\u7528\u8d44\u8baf\u6807\u9898\u6216URL\u8fdb\u884c\u624b\u52a8\u641c\u7d22\u3002\\\"\\n  }\\n]\"}}"
      }
    ]
  }
}