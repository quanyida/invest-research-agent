# ============================================================
# 复制为 .env 后按需修改；.env 已被 .gitignore 忽略。
#   Copy-Item .env.example .env        (Windows)
#   cp .env.example .env               (macOS / Linux)
#
# 数据库默认值对应 docker-compose.yml，填好 LLM_API_KEY 即可问答。
# 没有密钥也能启动并打开页面，但无法生成回答：
#   /healthz、/readyz、/ui/ 均可用。
# ============================================================

# ---------- 应用 ----------
APP_ENV=dev
APP_SECRET=dev-only-change-me
APP_BASE_URL=http://127.0.0.1:8000
LOG_LEVEL=INFO

# ---------- 数据库 ----------
# 默认对应 docker compose 暴露的 127.0.0.1:55432。
# scripts/bootstrap_db.py 会用管理员连接创建角色和库，再执行 infra/sql。
# 这里的密码只用于本地开发，部署时必须更换。
DATABASE_URL=postgresql+psycopg://invest_app:ira_dev_9f3c@127.0.0.1:55432/invest

# 管理员连接（可选）。不填时由 bootstrap 按下面的变量推导：
#   PG_ADMIN_USER / PG_ADMIN_PASSWORD / PG_ADMIN_DB
# 如果使用外部 PostgreSQL，直接给一条完整的管理员 DSN 更省事：
# PG_ADMIN_URL=postgresql://postgres:your-password@127.0.0.1:5432/postgres

# docker compose 中 postgres 容器的超级用户密码（bootstrap 也会读取）
POSTGRES_ADMIN_PASSWORD=invest_admin_dev

# ---------- 对话模型（OpenAI 兼容接口）----------
# 智谱：https://open.bigmodel.cn/api/paas/v4    模型 glm-4.6 / glm-4-plus
# 阿里：https://dashscope.aliyuncs.com/compatible-mode/v1   模型 qwen-plus
# 深度求索：https://api.deepseek.com/v1         模型 deepseek-chat
# OpenAI：https://api.openai.com/v1             模型 gpt-4.1-mini
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=
LLM_MODEL=glm-4.6
LLM_TEMPERATURE=0.2
# 推理模型的 completion_tokens 含思考过程，研究型任务建议 8192
LLM_MAX_TOKENS=8192
LLM_TIMEOUT_SECONDS=60
LLM_CONTEXT_SIZE=1000000

# ---------- 兜底模型（可选）----------
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# ---------- iFinD 官方 MCP ----------
# IFIND_MCP_TOKEN 为空时，iFinD 工具不可用（没有内置假数据）。
# 没有 token 仍可启动服务，只是回答无法取到 iFinD 数据。
IFIND_MCP_BASE=https://api-mcp.51ifind.com:8643/ds-mcp-servers
IFIND_MCP_TOKEN=
IFIND_MCP_TIMEOUT_SECONDS=15
IFIND_MCP_MAX_RETRIES=1

# ---------- Redis（可选）----------
# docker compose 已包含 Redis；连不上时会自动退回进程内缓存。
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PREFIX=ira

# ---------- Agent 预算 ----------
MAX_STEPS=6
# Deprecated: 单轮工具配额已移除，仅保留给旧脚本兼容。
MAX_TOOL_CALLS=8
MAX_TOKENS_PER_TASK=8000
TASK_TIMEOUT_SECONDS=90
MODEL_MAX_ATTEMPTS=4
HISTORY_TURNS=3

# ---------- 限额 ----------
MAX_UPLOAD_MB=50

# ---------- 网络代理（仅在本机需要代理时取消注释）----------
# HTTP_PROXY=http://127.0.0.1:10808
# HTTPS_PROXY=http://127.0.0.1:10808

# ---------- Durable run queue ----------
# API 进程默认不跑 Worker；生产环境由 Agent Service（:8001）消费队列。
# 单进程开发时设为 true，让 API 进程内也跑一个 Worker。
RUN_WORKER_ENABLED=false
RUN_QUEUE_POLL_SECONDS=0.05
RUN_LEASE_SECONDS=120
RUN_MAX_ATTEMPTS=2
EVENT_POLL_SECONDS=0.05
EVENT_TAIL_TIMEOUT_SECONDS=600

# ---------- Web Search（Tavily，可选）----------
# 不填 KEY 时网页搜索工具不会出现在工具列表里。
WEB_SEARCH_ENABLED=true
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_BASE_URL=https://api.tavily.com/search
WEB_SEARCH_API_KEY=
WEB_SEARCH_TIMEOUT_SECONDS=12
WEB_SEARCH_MAX_RESULTS=10
WEB_SEARCH_CACHE_TTL_SECONDS=600
CHAT_CONCURRENCY=8
RESEARCH_CONCURRENCY=2
