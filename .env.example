# ============================================================
# 本地配置：填完就能跑。不要提交到 git。
# 复制自 .env.example，按需修改。
# ============================================================

# ---------- 应用 ----------
APP_ENV=dev
APP_SECRET=dev-only-change-me
APP_BASE_URL=http://127.0.0.1:8000
LOG_LEVEL=INFO

# ---------- 数据库 ----------
# 本地默认 SQLite，零依赖；装了 Postgres 再换下面那行
DATABASE_URL=sqlite:///./data/app.db
# DATABASE_URL=postgresql+psycopg://invest:invest@127.0.0.1:5432/invest

# ---------- 对话模型（OpenAI 兼容接口）----------
# 智谱：https://open.bigmodel.cn/api/paas/v4    模型 glm-4.6 / glm-4-plus
# 阿里：https://dashscope.aliyuncs.com/compatible-mode/v1   模型 qwen-plus
# 深度求索：https://api.deepseek.com/v1         模型 deepseek-chat
# OpenAI：https://api.openai.com/v1             模型 gpt-4.1-mini
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=
LLM_MODEL=glm-4.6
LLM_TEMPERATURE=0.2
# SCNet-Max 等推理模型的 completion_tokens 含思考过程，研究型任务建议 8192
LLM_MAX_TOKENS=8192
LLM_TIMEOUT_SECONDS=60
LLM_CONTEXT_SIZE=1000000

# ---------- 兜底模型（可选，主模型失败时切换）----------
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# ---------- iFinD 官方 MCP ----------
# 先留空：留空时自动使用内置假 MCP（本地演示数据）
IFIND_MCP_BASE=https://api-mcp.51ifind.com:8643/ds-mcp-servers
IFIND_MCP_URL=https://api-mcp.51ifind.com:8643/ds-mcp-servers/hexin-ifind-ds-stock-mcp
IFIND_MCP_TOKEN=your-token
IFIND_MCP_TIMEOUT_SECONDS=15
IFIND_MCP_MAX_RETRIES=1

# ---------- Redis ----------
# 装好 Redis 后填真实地址；连不上会自动退回进程内缓存
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PREFIX=ira

# ---------- Agent 预算 ----------
MAX_STEPS=6
# Deprecated: single-turn tool quota removed; kept only for compatibility.
MAX_TOOL_CALLS=8
MAX_TOKENS_PER_TASK=8000
TASK_TIMEOUT_SECONDS=90

# ---------- 限额 ----------
MAX_UPLOAD_MB=50

# ---------- 网络（需要代理时填写）----------
HTTP_PROXY=http://127.0.0.1:10808
HTTPS_PROXY=http://127.0.0.1:10808
# ---------- Durable run queue（C 路线）----------
# POST /chat 只入队；后台 worker 领取执行，断线不影响任务
RUN_WORKER_ENABLED=true
RUN_QUEUE_POLL_SECONDS=0.2
RUN_LEASE_SECONDS=900
RUN_MAX_ATTEMPTS=2
EVENT_POLL_SECONDS=0.15
EVENT_TAIL_TIMEOUT_SECONDS=600
# ---------- Web Search (Tavily) ----------
WEB_SEARCH_ENABLED=true
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_BASE_URL=https://api.tavily.com/search
WEB_SEARCH_API_KEY=
WEB_SEARCH_TIMEOUT_SECONDS=12
WEB_SEARCH_MAX_RESULTS=10
WEB_SEARCH_CACHE_TTL_SECONDS=600
